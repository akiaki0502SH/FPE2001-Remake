<UserControl x:Class="Fpe2001Remake.UI.Views.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fpe2001Remake.UI.Converters">
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="DangerBrushConverter" />
    </UserControl.Resources>
    <Border Height="{StaticResource ActionbarHeight}"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1">
        <ItemsControl ItemsSource="{Binding Actions}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10,0" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ActionButton}"
                            Margin="4,0"
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding Command}"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip="{Binding ToolTip}"
                            Foreground="{Binding IsDanger, Converter={StaticResource DangerBrushConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ShortcutHint}"
                                       Margin="6,0,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
