<Window x:Class="Fpe2001Remake.UI.Views.ProcessOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打开进程内存视图"
        Width="420" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="进程 ID（PID）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" x:Name="PidBox" Height="30" VerticalContentAlignment="Center"
                 Padding="8,0" BorderBrush="{StaticResource LineBrush}" />

        <TextBlock Grid.Row="2" Text="基地址（十六进制，如 0x7FF600000000；留空用 0）" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
        <TextBox Grid.Row="3" x:Name="BaseBox" Height="30" VerticalContentAlignment="Center"
                 Padding="8,0" BorderBrush="{StaticResource LineBrush}" FontFamily="{StaticResource MonoFont}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="打开" Style="{StaticResource PrimaryButton}" Width="84" Click="Ok_Click" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
