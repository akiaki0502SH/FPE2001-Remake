<UserControl x:Class="Fpe2001Remake.UI.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <!-- ===== 动作栏 ===== -->
        <views:ActionBar DockPanel.Dock="Top" />

        <!-- ===== 顶部条件面板 ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="目标进程" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Width="64" />
                    <Button Content="刷新" Style="{StaticResource ActionButton}" Height="30" Width="58"
                            Command="{Binding RefreshTargetsCommand}" DockPanel.Dock="Right" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTarget.HasMultipleInstances}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="实例" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding SelectedTarget.Instances}"
                                  SelectedItem="{Binding SelectedProcessId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="106" Height="30" VerticalContentAlignment="Center"
                                  ToolTip="同名程序的进程实例 PID；扫描和地址表会绑定当前选择的 PID" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="Display"
                              Height="30" VerticalContentAlignment="Center"
                              FontFamily="{StaticResource UiFont}" FontSize="12.5"
                              ToolTip="按程序名合并显示；多实例程序请在右侧选择 PID">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="任务" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Width="64" />
                    <TextBox Text="{Binding MissionName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource UiFont}" FontSize="12.5"
                             BorderBrush="{StaticResource LineBrush}" Padding="8,0" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="扫描条件" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Width="64" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding DataTypes}"
                                  SelectedItem="{Binding SelectedDataType}"
                                  Width="86" Height="30" VerticalContentAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Comparisons}"
                                  SelectedItem="{Binding SelectedComparison}"
                                  Width="86" Height="30" VerticalContentAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" Height="30" VerticalContentAlignment="Center"
                                 Margin="8,0,0,0" Padding="8,0"
                                 BorderBrush="{StaticResource LineBrush}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                 ToolTip="十进制数值；支持 0x 十六进制（如 0x21=33 十进制）。比较类型为“变化/未变/未知值”时可为空。输入后按 Enter 直接扫描">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <TextBlock Text="{Binding StateDetail}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== 底部状态 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ===== 候选表格 ===== -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Candidates}"
                      SelectedItem="{Binding SelectedCandidate}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="28"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      FontFamily="{StaticResource UiFont}" FontSize="12.5"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="8,0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="190"
                                        FontFamily="{StaticResource MonoFont}" />
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="64" />
                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="130" />
                    <DataGridTextColumn Header="上次值" Binding="{Binding PreviousValue}" Width="130" />
                    <DataGridTextColumn Header="宿主证据" Binding="{Binding HostEvidence}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="添加到地址表" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddToAddressTableCommand}" />
                <Button Content="写入" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding WriteCandidateCommand}"
                        ToolTip="修改选中候选的值（立即写入内存，并自动加入地址表）" />
                <Button Content="{Binding CandidateFreezeButtonText}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding FreezeCandidateCommand}"
                        ToolTip="锁定选中候选的值（持续写回，防游戏改变）；再点一次解除" />
                <Button Content="在编辑器中打开" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding OpenInEditorCommand}"
                        ToolTip="跳转十六进制编辑器并定位到选中候选的地址" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
