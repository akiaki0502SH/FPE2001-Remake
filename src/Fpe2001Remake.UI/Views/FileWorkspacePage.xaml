<UserControl x:Class="Fpe2001Remake.UI.Views.FileWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fpe2001Remake.UI.ViewModels.Modules"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <views:ActionBar DockPanel.Dock="Top" />

        <!-- ===== 扫描面板 ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="模式" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Padding="8,0" BorderBrush="{StaticResource LineBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         ToolTip="十六进制（支持 ?? 通配）或文本/数值模式" />
                <ComboBox ItemsSource="{Binding ScanTypes}" SelectedItem="{Binding ScanType}"
                          Width="90" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <CheckBox Content="递归子目录" IsChecked="{Binding Recursive}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Margin="16,0,0,0" FontSize="11" />
            </DockPanel>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===== 主区域：左目录树 / 右文件+命中 ===== -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 目录树 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <TreeView ItemsSource="{Binding Root.Children}" SelectedItemChanged="Tree_SelectedItemChanged"
                          BorderThickness="0" Background="Transparent"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNode}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- 文件列表 + 命中 -->
            <DockPanel Grid.Column="2">
                <TextBlock Text="文件（双击在十六进制中打开）" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           DockPanel.Dock="Top" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                          MouseDoubleClick="Files_DoubleClick"
                          Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1" FontSize="12" SelectionMode="Single"
                          MaxHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="内容扫描命中（双击在十六进制中打开）" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           DockPanel.Dock="Top" Margin="0,12,0,4" />
                <DataGrid ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                          MouseDoubleClick="Hits_DoubleClick"
                          Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1" FontSize="12" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="偏移" Binding="{Binding OffsetText}" Width="150" />
                        <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="60" />
                        <DataGridTextColumn Header="预览" Binding="{Binding Preview}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
