<UserControl x:Class="Fpe2001Remake.UI.Views.HexEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <views:ActionBar DockPanel.Dock="Top" />

        <!-- ===== 查找/编辑面板 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="查找" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"
                             Padding="8,0" BorderBrush="{StaticResource LineBrush}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             ToolTip="输入后按 Enter 直接查找">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="查找 (F2)" Style="{StaticResource ActionButton}" Height="30" Margin="8,0,0,0"
                            Command="{Binding FindCommand}" />
                    <TextBlock Text="编码" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="20,0,0,0" />
                    <ComboBox ItemsSource="{Binding Encodings}"
                              Width="96" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"
                              SelectedItem="{Binding Encoding}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding EditModeText}" VerticalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                    <Button Content="编辑模式" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                            Command="{Binding ToggleEditModeCommand}" />
                    <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center"
                             Padding="8,0" BorderBrush="{StaticResource LineBrush}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             ToolTip="十六进制字节（如 DE AD BE EF），应用到选中行起始偏移" />
                    <Button Content="应用覆盖" Style="{StaticResource PrimaryButton}" Height="30" Margin="8,0,0,0"
                            Command="{Binding ApplyEditCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource DangerBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== 十六进制网格（虚拟化） ===== -->
        <Grid Margin="12">
            <DataGrid x:Name="HexGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Vertical"
                      RowHeight="22"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                      SelectionMode="Single"
                      SelectionUnit="Cell"
                      CurrentCellChanged="HexGrid_CurrentCellChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ColumnHeaderHeight="26">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- 字节级高亮：醒目黄色 + 深色字（定位/选中当前字节用） -->
                                <Setter Property="Background" Value="#FFFFD54F" />
                                <Setter Property="Foreground" Value="#FF202020" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                <Setter Property="Background" Value="#F5EFDC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="偏移" Binding="{Binding OffsetText}" Width="150" />
                    <DataGridTextColumn Header="00" Binding="{Binding [0]}" Width="44" />
                    <DataGridTextColumn Header="01" Binding="{Binding [1]}" Width="44" />
                    <DataGridTextColumn Header="02" Binding="{Binding [2]}" Width="44" />
                    <DataGridTextColumn Header="03" Binding="{Binding [3]}" Width="44" />
                    <DataGridTextColumn Header="04" Binding="{Binding [4]}" Width="44" />
                    <DataGridTextColumn Header="05" Binding="{Binding [5]}" Width="44" />
                    <DataGridTextColumn Header="06" Binding="{Binding [6]}" Width="44" />
                    <DataGridTextColumn Header="07" Binding="{Binding [7]}" Width="44" />
                    <DataGridTextColumn Header="08" Binding="{Binding [8]}" Width="44" />
                    <DataGridTextColumn Header="09" Binding="{Binding [9]}" Width="44" />
                    <DataGridTextColumn Header="0A" Binding="{Binding [10]}" Width="44" />
                    <DataGridTextColumn Header="0B" Binding="{Binding [11]}" Width="44" />
                    <DataGridTextColumn Header="0C" Binding="{Binding [12]}" Width="44" />
                    <DataGridTextColumn Header="0D" Binding="{Binding [13]}" Width="44" />
                    <DataGridTextColumn Header="0E" Binding="{Binding [14]}" Width="44" />
                    <DataGridTextColumn Header="0F" Binding="{Binding [15]}" Width="44" />
                    <DataGridTextColumn Header="文本" Binding="{Binding Text}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
