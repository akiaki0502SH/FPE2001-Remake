<UserControl x:Class="Fpe2001Remake.UI.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">
        <views:ActionBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Background="#99FBFBFA" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,13,20,11">
            <StackPanel>
                <TextBlock Text="关于 FPE2001-Remake" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="保留原版任务路径，在 Windows 11 x64 上重新实现并扩展模拟器适配能力。"
                           Style="{StaticResource PageSubtitleText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Border Style="{StaticResource CardBorder}" Width="760" Padding="36"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="74" Height="74" CornerRadius="18" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="FP" Foreground="White" FontWeight="Bold" FontSize="25"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FPE2001-Remake" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Windows 11 x64 重构版 · UI Design Kit v2.1"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                    <TextBlock Text="内存搜索、地址表、十六进制编辑、文件扫描、图片工具、宏按键和速度控制均保留在原有功能边界内。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="620" Margin="0,22,0,0" />
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceAltBrush}"
                            HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="仅限单机与授权环境" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
