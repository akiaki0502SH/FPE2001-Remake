<UserControl x:Class="Fpe2001Remake.UI.Views.AddressesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <!-- ===== 动作栏 ===== -->
        <views:ActionBar DockPanel.Dock="Top" />

        <!-- ===== 底部操作 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="立即写入" Style="{StaticResource PrimaryButton}" Command="{Binding WriteNowCommand}" />
                <Button Content="冻结 / 停止冻结" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding FreezeToggleCommand}" />
                <Button Content="删除" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding RemoveCommand}" />
                <Button Content="清空" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
                <TextBlock Text="冻结 = 按写入值周期性锁定；Ctrl+Shift+F12 全局停止"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== 条目表格 ===== -->
        <Grid Margin="12">
            <DataGrid ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="30"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      FontFamily="{StaticResource UiFont}" FontSize="12.5"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="8,0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="冻结" Binding="{Binding FreezeStateText}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FreezeRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="描述" Binding="{Binding Label}" Width="140" />
                    <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="90" />
                    <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="190"
                                        FontFamily="{StaticResource MonoFont}" />
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="70" />
                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="110"
                                        FontFamily="{StaticResource MonoFont}" />
                    <DataGridTemplateColumn Header="写入值" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         BorderThickness="0" Background="Transparent" Padding="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
