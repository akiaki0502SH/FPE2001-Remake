<UserControl x:Class="Fpe2001Remake.UI.Views.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fpe2001Remake.UI.ViewModels.Modules"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <views:ActionBar DockPanel.Dock="Top" />

        <!-- 路径栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="文件夹" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <Button Content="浏览" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                        DockPanel.Dock="Right" Command="{Binding BrowseCommand}" />
                <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource LineBrush}" />
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 图片网格 -->
        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaItemRow}">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Margin="4" Padding="8"
                                Width="150" Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown">
                            <StackPanel>
                                <Border Height="100" Background="{StaticResource CanvasBrush}" CornerRadius="2">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock FontSize="10.5" Foreground="{StaticResource MutedBrush}">
                                    <Run Text="{Binding DimensionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Format, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
