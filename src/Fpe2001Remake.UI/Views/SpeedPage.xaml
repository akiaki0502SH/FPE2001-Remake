<UserControl x:Class="Fpe2001Remake.UI.Views.SpeedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <views:ActionBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Background="#99FBFBFA" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,13,20,11">
            <StackPanel>
                <TextBlock Text="速度调整" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="仅在模拟器适配器声明能力时启用，不向目标进程注入未知模块。"
                           Style="{StaticResource PageSubtitleText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,34" Width="880" HorizontalAlignment="Center">
            <!-- 适配器状态卡 -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="适配器" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding AdapterName}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="能力" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CapabilitiesText}" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                    <TextBlock Grid.Row="2" Text="连接" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                        <Run Text="{Binding Connected, Mode=OneWay}" /><Run Text="  ·  按 F1 重新连接" />
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 速度控制（有能力时） -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="26" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="启用" IsChecked="{Binding SpeedEnabled}"
                                  IsEnabled="{Binding HasSpeedControl}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="当前倍率" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding MultiplierText}" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}" FontSize="46"
                               Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <Slider Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                            Value="{Binding Multiplier}" IsEnabled="{Binding HasSpeedControl}"
                            Margin="18,20,18,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="0.25x" Style="{StaticResource GhostButton}" Height="28" Padding="12,0"
                                Command="{Binding SetMultiplierHalfCommand}" IsEnabled="{Binding HasSpeedControl}" />
                        <Button Content="1x" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding SetMultiplier1xCommand}" IsEnabled="{Binding HasSpeedControl}" />
                        <Button Content="2x" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding SetMultiplier2xCommand}" IsEnabled="{Binding HasSpeedControl}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 无能力说明 -->
            <Border Background="#E6ECE8" BorderBrush="#CAD8CE"
                    BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Text="速度控制仅由模拟器适配器声明能力后提供（暂停/快进/倍率是独立能力）。当前目标无此能力时不尝试通用 DLL 钩子——这是设计行为。演示：以 -demo 参数启动 Fpe2001Remake.AdapterHost.exe 后按 F1 重新连接。" />
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
