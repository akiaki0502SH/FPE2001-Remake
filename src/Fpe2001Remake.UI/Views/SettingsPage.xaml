<UserControl x:Class="Fpe2001Remake.UI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fpe2001Remake.UI.Views">
    <DockPanel Background="{StaticResource WindowBrush}">

        <views:ActionBar DockPanel.Dock="Top" />

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- 扫描 -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="扫描" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="内存读取上限 (MiB)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding MemoryLimitMb}" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Grid.Row="1" Text="扫描块大小 (KiB)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScanBlockSizeKb}" Height="30" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 文件与编辑 -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="文件与编辑" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="临时目录" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding TempDirectory}" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}" ToolTip="留空使用系统临时目录" />
                            <TextBlock Grid.Row="1" Text="保存前创建备份" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center" Margin="4,8,0,0" />
                            <TextBlock Grid.Row="2" Text="撤销配额 (MiB)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UndoQuotaMb}" Height="30" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 写入与锁定 -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="写入与锁定" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="冻结间隔 (ms)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding FreezeIntervalMs}" Height="30" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}" ToolTip="最短 16ms，默认 250ms" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 兼容与隐私 -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="兼容与隐私" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="旧配置导入预览（FPE2001 旧版 INI/CSV/TSV/二进制）"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                     VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{StaticResource LineBrush}"
                                     ToolTip="旧配置文件路径" />
                            <Button Grid.Column="1" Content="预览导入" Style="{StaticResource PrimaryButton}" Height="30"
                                    Margin="8,0,0,0" Command="{Binding ImportPreviewCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding ImportStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                        <DataGrid ItemsSource="{Binding ImportFields}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="24" Height="160"
                                  Margin="0,8,0,0" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
