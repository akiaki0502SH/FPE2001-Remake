<Window x:Class="Fpe2001Remake.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fpe2001Remake.UI.ViewModels"
        xmlns:vmmod="clr-namespace:Fpe2001Remake.UI.ViewModels.Modules"
        xmlns:conv="clr-namespace:Fpe2001Remake.UI.Converters"
        xmlns:views="clr-namespace:Fpe2001Remake.UI.Views"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FPE2001-Remake"
        Icon="/Fpe2001Remake.UI;component/Assets/FPE2001-Remake.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToBrushConverter x:Key="DangerBrushConverter" />

        <!-- 具体模块页（P1/P2：扫描/地址表/十六进制为真实工作区） -->
        <DataTemplate DataType="{x:Type vmmod:ScanViewModel}">
            <views:ScanPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:AddressTableViewModel}">
            <views:AddressesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:HexEditorViewModel}">
            <views:HexEditorPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:FileWorkspaceViewModel}">
            <views:FileWorkspacePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:MediaWorkspaceViewModel}">
            <views:MediaPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:MacroWorkspaceViewModel}">
            <views:MacroPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:SpeedViewModel}">
            <views:SpeedPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmmod:AboutViewModel}">
            <views:AboutPage />
        </DataTemplate>

        <!-- 模块页统一模板（动作栏 44 + 内容区；其余模块 P1 保持占位，逐阶段替换） -->
        <DataTemplate DataType="{x:Type vm:ModuleViewModelBase}">
            <DockPanel>
                <!-- 动作栏 -->
                <Border DockPanel.Dock="Top"
                        Height="{StaticResource ActionbarHeight}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,1">
                    <ItemsControl ItemsSource="{Binding Actions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionButton}"
                                        Margin="4,0"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        ToolTip="{Binding ToolTip}"
                                        Foreground="{Binding IsDanger, Converter={StaticResource DangerBrushConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ShortcutHint}"
                                                   Margin="6,0,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 内容区：模块图标 + 标题 + 状态徽章 + 详情 + 工作区占位 -->
                <Grid Background="{StaticResource WindowGradient}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                        <Border Width="78" Height="78" CornerRadius="24"
                                Background="{StaticResource ModuleIconGradient}"
                                BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Effect="{StaticResource CardShadow}">
                            <TextBlock Text="{Binding Definition.IconGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="38"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Definition.Title}"
                                   FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <Border Style="{StaticResource StatusBadge}"
                                Background="{StaticResource PrimarySoftBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{Binding StateText}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="11.5" />
                        </Border>
                        <TextBlock Text="{Binding StateDetail}"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardRadius}"
                                Padding="18"
                                Margin="0,16,0,0">
                            <TextBlock Text="{Binding WorkspacePlaceholder}"
                                        Foreground="{StaticResource MutedBrush}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        FontSize="12.5" />
                        </Border>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="10"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- v3.0：Design Kit v2.1 的 44/66/内容/31 六层窗口结构。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitlebarRowHeight}" />
            <RowDefinition Height="{StaticResource ModuleStripRowHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource StatusbarRowHeight}" />
        </Grid.RowDefinitions>

        <!-- 标题栏：品牌左置、当前目标居中、状态与系统按钮固定最右。 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource PrimaryBrush}">
                        <Image Source="/Fpe2001Remake.UI;component/Assets/FPE2001-Remake.ico" Width="18" Height="18" />
                    </Border>
                    <TextBlock Text="FPE2001-Remake" FontWeight="SemiBold" FontSize="13.5"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="当前目标：" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding CurrentTarget}" Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="  " />
                    <TextBlock Text="{Binding TargetDetail}" Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 运行状态徽章（冻结/宏/速度） -->
                    <Border Style="{StaticResource StatusBadge}"
                            Background="#EEE8DE" BorderBrush="#D8CCB8"
                            Visibility="{Binding FreezeRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="冻结运行中" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}"
                            Background="#EEE8DE" BorderBrush="#D8CCB8"
                            Margin="6,0,0,0"
                            Visibility="{Binding MacroRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="宏运行中" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Margin="6,0,0,0"
                            Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                            Visibility="{Binding SpeedNonDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="11">
                            <Run Text="速度 " /><Run Text="{Binding SpeedText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <!-- 窗口按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,0"
                                chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"
                            Width="46" Height="44" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource MutedBrush}" ToolTip="最小化"
                            AutomationProperties.Name="最小化窗口"
                            chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowButton}">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click"
                            Width="46" Height="44" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource MutedBrush}" ToolTip="最大化/还原"
                            AutomationProperties.Name="最大化或还原窗口"
                            chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowButton}">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Width="46" Height="44" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource MutedBrush}" ToolTip="关闭"
                            AutomationProperties.Name="关闭窗口"
                            chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseWindowButton}">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 九模块横向导航：结构与顺序保持不变 ========== -->
        <Border Grid.Row="1" Background="#E7EAEA"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="moduleStrip"
                                     Style="{StaticResource ModuleButton}"
                                     Tag="{Binding Definition.IconGlyph}"
                                     Content="{Binding Definition.Title}"
                                     IsChecked="{Binding IsActive, Mode=OneWay}"
                                     ToolTip="{Binding Definition.ShortcutText}"
                                     Checked="ModuleRadio_Checked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ========== 内容区 ========== -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentModule}"
                        Background="{StaticResource WindowBrush}" />

        <!-- ========== 状态栏 31 DIP ========== -->
        <Border Grid.Row="3" Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusSource}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" />
                    <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource LineBrush}"
                               VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" />
                    <TextBlock Text="{Binding StatusProgress}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentModuleShortcut, StringFormat=模块 {0}}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"
                               VerticalAlignment="Center" TextAlignment="Center" LineHeight="16" />
                    <Button Style="{StaticResource DangerButton}"
                            Height="24" Padding="10,0" FontSize="11" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Content="全局停止  Ctrl+Shift+F12"
                            Command="{Binding StopAllCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
