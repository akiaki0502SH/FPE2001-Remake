<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- v2.4 Deep Boundary Blue 主题：保留原布局与操作逻辑，提升灰蓝画布、控件边框和表格分隔线的对比度。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#E9EEF3" />
    <SolidColorBrush x:Key="WindowBrush" Color="#DDE3EA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="LineBrush" Color="#AAB6C4" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#75869A" />
    <SolidColorBrush x:Key="TextBrush" Color="#18222E" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4F5F70" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#245F9E" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#174574" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#D5E5F6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2D9760" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B97927" />
    <SolidColorBrush x:Key="DangerBrush" Color="#CF4B4B" />

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E4EAF0" Offset="0" />
        <GradientStop Color="#D8E0E8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E5EBF1" Offset="0" />
        <GradientStop Color="#D7DFE8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F4F7FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F73B5" Offset="0" />
        <GradientStop Color="#245F9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ModuleIconGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3F7FB" Offset="0" />
        <GradientStop Color="#DCE9F5" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#233447" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#233447" />
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.11" Color="#233447" />

    <!-- 字体 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- 尺寸（DIP） -->
    <sys:Double x:Key="TitlebarHeight">46</sys:Double>
    <sys:Double x:Key="ModuleStripHeight">72</sys:Double>
    <sys:Double x:Key="ActionbarHeight">48</sys:Double>
    <sys:Double x:Key="StatusbarHeight">31</sys:Double>
    <sys:Double x:Key="ControlHeight">33</sys:Double>

    <!-- 网格行高（GridLength） -->
    <GridLength x:Key="TitlebarRowHeight">46</GridLength>
    <GridLength x:Key="ModuleStripRowHeight">72</GridLength>
    <GridLength x:Key="StatusbarRowHeight">31</GridLength>

    <!-- 圆角 -->
    <CornerRadius x:Key="WindowRadius">10</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>

</ResourceDictionary>
