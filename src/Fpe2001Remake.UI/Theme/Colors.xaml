<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- v2.3 Clear Blue 主题：参考现代 Win11 工具的浅灰画布、白色面板、蓝色交互和细分隔线。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="WindowBrush" Color="#F1F3F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7FAFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E1E5EA" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#CBD2DA" />
    <SolidColorBrush x:Key="TextBrush" Color="#20252B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6D7682" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F7BEA" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1F5FBE" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E6F1FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2D9760" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B97927" />
    <SolidColorBrush x:Key="DangerBrush" Color="#CF4B4B" />

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F6F8" Offset="0" />
        <GradientStop Color="#EEF1F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F9FAFC" Offset="0" />
        <GradientStop Color="#F3F6FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAFBFC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D88F4" Offset="0" />
        <GradientStop Color="#2F7BEA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ModuleIconGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FBFF" Offset="0" />
        <GradientStop Color="#E5F1FF" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#1B2733" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#1B2733" />
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#1B2733" />

    <!-- 字体 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- 尺寸（DIP） -->
    <sys:Double x:Key="TitlebarHeight">46</sys:Double>
    <sys:Double x:Key="ModuleStripHeight">72</sys:Double>
    <sys:Double x:Key="ActionbarHeight">48</sys:Double>
    <sys:Double x:Key="StatusbarHeight">31</sys:Double>
    <sys:Double x:Key="ControlHeight">33</sys:Double>

    <!-- 网格行高（GridLength） -->
    <GridLength x:Key="TitlebarRowHeight">46</GridLength>
    <GridLength x:Key="ModuleStripRowHeight">72</GridLength>
    <GridLength x:Key="StatusbarRowHeight">31</GridLength>

    <!-- 圆角 -->
    <CornerRadius x:Key="WindowRadius">10</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>

</ResourceDictionary>
